{
  "title": "weebo-notify (instances)",
  "uid": "weebo-notify-instances",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "weebo-notify"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(realtime_connections{notify_instance!=\"\"}, namespace)",
        "refresh": 2,
        "label": "Namespace"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(realtime_connections{namespace=\"$namespace\",notify_instance!=\"\"}, notify_instance)",
        "refresh": 2,
        "includeAll": true,
        "label": "Instance"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Realtime connections",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (transport) (realtime_connections{namespace=\"$namespace\",notify_instance=~\"$instance\"})",
          "legendFormat": "{{transport}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Notifications published / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(notifications_published_total{namespace=\"$namespace\",notify_instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Push latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, transport) (rate(push_delivery_duration_seconds_bucket{namespace=\"$namespace\",notify_instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{transport}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Push failure ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (transport) (rate(push_failures_total{namespace=\"$namespace\",notify_instance=~\"$instance\"}[$__rate_interval])) / sum by (transport) (rate(push_delivery_duration_seconds_count{namespace=\"$namespace\",notify_instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{transport}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Seconds since last successful job pass (leader)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (task) (background_job_last_success_timestamp_seconds{namespace=\"$namespace\",notify_instance=~\"$instance\"})",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sink dead letters (leader)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (channel) (sink_dlq_depth{namespace=\"$namespace\",notify_instance=~\"$instance\"})",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retention backlog rows (leader)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kind) (retention_backlog_rows{namespace=\"$namespace\",notify_instance=~\"$instance\"})",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sync backlog p95 (events per catch-up)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sync_backlog_size_bucket{namespace=\"$namespace\",notify_instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
